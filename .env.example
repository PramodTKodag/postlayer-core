# Copy to .env (git-ignored) and fill in. The `release` service (make release-*) is the only one that mounts
# keystores and passes this file as environment variables. The file itself still sits in the workspace mount, readable
# by every tooling container, and forge auto-loads it: do not run untrusted code through `make shell` or
# `make test-upgrades` while it holds real RPC keys.
# Never put a private key or keystore password here.

# Space-separated chain ids of this release (digits only, no leading zero; not chain names). Each id must have an
# entry in chains.json (display name, explorer and a default public RPC URL live there, not here).
CHAINS="84532 11155111"

# Optional, per chain: your own RPC URL (for example a private or paid endpoint) instead of the public one in
# chains.json. The name is CHAIN_<chain id>_RPC_URL. It may contain a key: never commit this file.
# CHAIN_84532_RPC_URL=

# Proxy owner (a dedicated testnet account, never reused on mainnet) and the salt label for the addresses.
OWNER=
# Set to true when OWNER is a plain account (EOA). Unset, preflight requires OWNER to have code on every chain (a contract wallet).
OWNER_IS_EOA=
SALT_LABEL=

# Deployer: the public address of the keystore account below (only used for the balance check and --sender).
DEPLOYER_ADDRESS=
# Name of the Foundry keystore account (created with `cast wallet import <name> --interactive`).
KEYSTORE_ACCOUNT=
# Host directory mounted read-only into the release container. Use a dedicated directory that contains only testnet
# accounts, not your everyday ~/.foundry/keystores.
KEYSTORE_DIR=~/.foundry/testnet-keystores

# Etherscan API v2 key. Optional: without it `make release-verify` skips Etherscan (Sourcify needs none).
ETHERSCAN_API_KEY=

# Manifest file name, written to deployments/<RELEASE_NAME>.json.
RELEASE_NAME=testnet-0.1.0
# Optional: directory for the manifest instead of deployments/.
# MANIFEST_DIR=
# RELEASE_FORK_TEST is set by `make test-fork-release` only; do not put it in this file.
